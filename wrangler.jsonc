{
  // Static meme maker site; src/worker.js adds Google AdSense to its pages.
  "name": "meme-maker",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // HTML pages go through the Worker so it can add template images and the AdSense tag.
    "run_worker_first": [
      "/", "/index.html", "/about", "/privacy", "/terms", "/contact", "/impressum",
      "/templates", "/templates/*"
    ],
    // Unknown URLs get 404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  // The AdSense publisher ID is public (it appears in every page), so it lives here.
  "vars": {
    "ADSENSE_CLIENT": "ca-pub-3276058118984177"
  },
  // Keep variables added in the Cloudflare dashboard (the ADSENSE_SLOT_* ad unit IDs)
  // instead of deleting them on each deploy.
  "keep_vars": true,
  // The rate limiter used by the removed AI features: v2 deletes it and its stored counters.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "deleted_classes": ["RateLimiter"] }
  ]
}
